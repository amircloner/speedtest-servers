# ─────────────────────────────────────────────────────────────────────────────
# Factor III – Config: copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed as documentation.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=5000
DEBUG=false
# Generate a strong random value for production:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Logging (Factor XI) ───────────────────────────────────────────────────────
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Backing service paths (Factor IV) ─────────────────────────────────────────
DB_FILE=db.json
RESULTS_DIR=results
CITY_PAIRS_FILE=country_city_pairs.csv

# ── Speedtest tuning ──────────────────────────────────────────────────────────
SPEEDTEST_CONCURRENCY=10
SPEEDTEST_INTER_TEST_DELAY=1
FETCH_INTER_BATCH_DELAY=2
FETCH_TIMEOUT=30
FETCH_RETRIES=3

# ── SSE stream ────────────────────────────────────────────────────────────────
STREAM_TTL=300
STREAM_POLL_TIMEOUT=30

# ── Gunicorn (Factor VIII – Concurrency) ─────────────────────────────────────
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=30
